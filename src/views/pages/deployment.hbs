<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Deployment</h1>
        <div>
          <span class="badge bg-primary me-2">Admin: {{user.email}}</span>
        </div>
      </div>

      <div class="card mb-4">
        <div class="card-header bg-dark text-white">
          <h5 class="mb-0">
            <i class="fas fa-microchip"></i>
            CPU and Memory
          </h5>
        </div>
        <div class="card-body">
          <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Current Total</div>
                <div class="fs-3 fw-semibold" id="cpuCurrentAvg">
                  {{#if cpuMetrics.latest}}
                    {{#if (gt cpuMetrics.coreCount 0)}}
                      {{toFixed (multiply cpuMetrics.latest.avg cpuMetrics.coreCount) 1}}%
                    {{else}}
                      {{toFixed cpuMetrics.latest.avg 1}}%
                    {{/if}}
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="cpuLastSample">
                  {{#if cpuMetrics.latest}}
                    Updated {{formatTimeAgoShortWithSeconds cpuMetrics.latest.ts}}
                  {{else}}
                    Collecting samples...
                  {{/if}}
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Core Range</div>
                <div class="fs-5 fw-semibold" id="cpuCoreRange">
                  {{#if cpuMetrics.latest}}
                    {{toFixed cpuMetrics.latest.min 1}}% - {{toFixed cpuMetrics.latest.max 1}}%
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="cpuCoreSpread">
                  {{#if cpuMetrics.latest}}
                    Spread: {{toFixed (subtract cpuMetrics.latest.max cpuMetrics.latest.min) 1}}%
                  {{else}}
                    Spread: --
                  {{/if}}
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Cores</div>
                <div class="fs-3 fw-semibold" id="cpuCoreCount">
                  {{#if (gt cpuMetrics.coreCount 0)}}
                    {{cpuMetrics.coreCount}}
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="cpuSampleInterval">
                  {{#if cpuMetrics.sampleIntervalMs}}
                    Sample interval: {{toFixed (divide cpuMetrics.sampleIntervalMs 1000) 0}}s
                  {{else}}
                    Sample interval: --
                  {{/if}}
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Uptime</div>
                <div class="fs-5 fw-semibold" id="cpuUptime">
                  {{#if cpuMetrics.uptimeMs}}
                    {{formatDurationMs cpuMetrics.uptimeMs}}
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="cpuStartedAt">
                  {{#if cpuMetrics.startedAt}}
                    Started: {{formatDateTimeShort cpuMetrics.startedAt}}
                  {{else}}
                    Started: --
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="fw-semibold text-muted">Memory Utilization</div>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Current Used</div>
                <div class="fs-3 fw-semibold" id="memoryCurrentPercent">
                  {{#if memoryMetrics.latest}}
                    {{toFixed memoryMetrics.latest.usedPercent 1}}%
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="memoryLastSample">
                  {{#if memoryMetrics.latest}}
                    Updated {{formatTimeAgoShortWithSeconds memoryMetrics.latest.ts}}
                  {{else}}
                    Collecting samples...
                  {{/if}}
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Used Memory</div>
                <div class="fs-5 fw-semibold" id="memoryUsedValue">
                  {{#if memoryMetrics.latest}}
                    {{toFixed (divide memoryMetrics.latest.usedBytes 1073741824) 1}} GB
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="memoryUsedTotal">
                  {{#if memoryMetrics.latest}}
                    of {{toFixed (divide memoryMetrics.latest.totalBytes 1073741824) 1}} GB total
                  {{else}}
                    of --
                  {{/if}}
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Free Memory</div>
                <div class="fs-5 fw-semibold" id="memoryFreeValue">
                  {{#if memoryMetrics.latest}}
                    {{toFixed (divide memoryMetrics.latest.freeBytes 1073741824) 1}} GB
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="memorySampleInterval">
                  {{#if memoryMetrics.sampleIntervalMs}}
                    Sample interval: {{toFixed (divide memoryMetrics.sampleIntervalMs 1000) 0}}s
                  {{else}}
                    Sample interval: --
                  {{/if}}
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <div class="border rounded p-3 h-100">
                <div class="text-muted small">Uptime</div>
                <div class="fs-5 fw-semibold" id="memoryUptime">
                  {{#if memoryMetrics.uptimeMs}}
                    {{formatDurationMs memoryMetrics.uptimeMs}}
                  {{else}}
                    --
                  {{/if}}
                </div>
                <div class="text-muted small" id="memoryStartedAt">
                  {{#if memoryMetrics.startedAt}}
                    Started: {{formatDateTimeShort memoryMetrics.startedAt}}
                  {{else}}
                    Started: --
                  {{/if}}
                </div>
              </div>
            </div>
          </div>
          <div class="text-muted small mb-4">
            Memory metrics reflect the entire host, including engine CLI calls.
          </div>
          <div class="position-relative" style="height: 320px;">
            <div id="cpuChartEmptyState" class="text-muted small text-center py-5">
              Collecting CPU samples...
            </div>
            <canvas id="cpuUsageChart" class="w-100 h-100 d-none"></canvas>
          </div>
          <div class="text-muted small mt-2">
            The line shows total utilization across all cores (100% per core). History includes every sample since the
            last app start. Memory usage (GB) is shown on the right axis.
          </div>
        </div>
      </div>

      <!-- Deployment Management Section -->
      <div class="card mb-4">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0">
            <i class="fas fa-server"></i>
            Deployment Management
          </h5>
        </div>
        <div class="card-body">
          {{#if deploymentControlsEnabled}}
            <p class="text-muted mb-3">
              <strong>Warning:</strong> Triggering a server update will run <code>deploy.sh update</code> (via the manual trigger), pull the latest code from the repository, rebuild the application, and restart the server. This will cause a brief period of downtime.
            </p>
            <div class="d-flex gap-2 flex-wrap">
              <form method="POST" action="/admin/deployment/trigger-update" class="d-inline">
                  {{> csrf-field}}
                <button type="submit" class="btn btn-warning"
                  onclick="return confirm('Are you sure you want to trigger a server update? The application will be unavailable for a moment.')">
                  <i class="fas fa-sync-alt"></i> Trigger Server Update
                </button>
              </form>
              <form method="POST" action="/admin/deployment/restart-app" class="d-inline">
                  {{> csrf-field}}
                <button type="submit" class="btn btn-secondary"
                  onclick="return confirm('Restarting the web application will restart the PM2 process and disconnect users. Continue?')">
                  <i class="fas fa-redo"></i> Restart Application
                </button>
              </form>
              <form method="POST" action="/admin/deployment/restart-server" class="d-inline">
                  {{> csrf-field}}
                <button type="submit" class="btn btn-danger"
                  onclick="return confirm('Restarting the host server will reboot the entire machine and terminate all sessions. Continue?')">
                  <i class="fas fa-power-off"></i> Restart Host Server
                </button>
              </form>
            </div>
          {{else}}
            <div class="alert alert-info mb-0">
              Deployment controls are only available on Linux hosts running {{siteName}} via <code>deploy.sh</code> under PM2.
            </div>
          {{/if}}
          <div class="border rounded p-3 mt-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
              <div class="fw-semibold">SSH Access</div>
              {{#if sshAccess.supported}}
                <span class="badge {{#if sshAccess.sshAllowedKnown}}{{#if sshAccess.sshAllowed}}bg-success{{else}}bg-secondary{{/if}}{{else}}bg-secondary{{/if}}">
                  SSH: {{#if sshAccess.sshAllowedKnown}}{{#if sshAccess.sshAllowed}}Enabled{{else}}Disabled{{/if}}{{else}}Unknown{{/if}}
                </span>
                <span class="badge {{#if sshAccess.firewallActiveKnown}}{{#if sshAccess.firewallActive}}bg-info{{else}}bg-secondary{{/if}}{{else}}bg-secondary{{/if}}">
                  Firewall: {{#if sshAccess.firewallActiveKnown}}{{#if sshAccess.firewallActive}}Active{{else}}Inactive{{/if}}{{else}}Unknown{{/if}}
                </span>
              {{/if}}
            </div>
            {{#if sshAccess.supported}}
              <div class="text-muted small mb-2">
                Manage inbound SSH (port 22) through UFW rules. Disabling SSH can lock you out unless you have console access.
              </div>
              <div class="d-flex flex-wrap gap-2">
                <form method="POST" action="/admin/deployment/ssh-enable" class="d-inline">
                  {{> csrf-field}}
                  <button
                    type="submit"
                    class="btn btn-outline-success"
                    {{#unless sshAccess.controlsEnabled}}disabled{{/unless}}
                    onclick="return confirm('Enable inbound SSH (port 22) via UFW?')"
                  >
                    <i class="fas fa-unlock-alt"></i> Enable SSH
                  </button>
                </form>
                <form method="POST" action="/admin/deployment/ssh-disable" class="d-inline">
                  {{> csrf-field}}
                  <button
                    type="submit"
                    class="btn btn-outline-danger"
                    {{#unless sshAccess.controlsEnabled}}disabled{{/unless}}
                    onclick="return confirm('Disable inbound SSH (port 22) via UFW? This can lock you out unless you have console access.')"
                  >
                    <i class="fas fa-lock"></i> Disable SSH
                  </button>
                </form>
              </div>
              {{#unless sshAccess.controlsEnabled}}
                <div class="alert alert-info mt-3 mb-0">
                  SSH toggles require the helper from <code>scripts/deploy.sh</code> (and passwordless sudo for the helper).
                </div>
              {{/unless}}
              {{#if sshAccess.error}}
                <div class="alert alert-warning mt-3 mb-0">{{sshAccess.error}}</div>
              {{/if}}
            {{else}}
              <div class="text-muted fst-italic">
                SSH controls are only available on Linux hosts with the SSH helper installed.
              </div>
            {{/if}}
          </div>
          <div class="border rounded p-3 mt-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
              <div class="fw-semibold">Repository Updates</div>
              {{#if deploymentCommitStatus}}
                <span class="badge {{#if (gt deploymentCommitStatus.behindCount 0)}}bg-warning text-dark{{else}}bg-success{{/if}}">
                  {{#if (gt deploymentCommitStatus.behindCount 0)}}
                    {{deploymentCommitStatus.behindCount}} behind
                  {{else}}
                    Up to date
                  {{/if}}
                </span>
              {{/if}}
            </div>
            {{#if deploymentCommitStatus}}
              {{#if deploymentCommitStatus.error}}
                <div class="alert alert-warning mb-0">{{deploymentCommitStatus.error}}</div>
              {{else}}
                <div class="text-muted small mb-2">
                  Comparing local HEAD against <code>origin/{{deploymentCommitStatus.defaultBranch}}</code> in
                  <code>{{deploymentCommitStatus.repoPath}}</code>.
                </div>
                {{#if (gt deploymentCommitStatus.behindCount 0)}}
                  <div class="text-muted small mb-2">Latest commits on the remote branch:</div>
                  <ul class="mb-0 ps-3">
                    {{#each deploymentCommitStatus.commitMessages}}
                      <li>
                        {{#if this.url}}
                          <a href="{{this.url}}" target="_blank" rel="noopener noreferrer">{{this.subject}}</a>
                        {{else}}
                          {{this.subject}}
                        {{/if}}
                      </li>
                    {{/each}}
                  </ul>
                  {{#if deploymentCommitStatus.truncated}}
                    <div class="text-muted small mt-2">
                      Showing {{deploymentCommitStatus.commitMessages.length}} of {{deploymentCommitStatus.behindCount}} commits.
                    </div>
                  {{/if}}
                {{else}}
                  <div class="text-muted fst-italic">Server code is up to date with the remote branch.</div>
                {{/if}}
              {{/if}}
            {{else}}
              <div class="text-muted fst-italic">
                Repository status is only available on Linux hosts running {{siteName}} via <code>deploy.sh</code>.
              </div>
            {{/if}}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cpuChartCanvas = document.getElementById('cpuUsageChart');
    if (!cpuChartCanvas || typeof Chart === 'undefined') {
      return;
    }

    const cpuChartEmptyState = document.getElementById('cpuChartEmptyState');

    const dateFormatter = new Intl.DateTimeFormat(undefined, {
      month: 'short',
      day: '2-digit',
      hour: '2-digit',
      minute: '2-digit'
    });

    let cpuChart = null;

    const formatPercent = (value) => {
      if (!Number.isFinite(value)) return '--';
      return `${value.toFixed(1)}%`;
    };

    const formatGb = (value) => {
      if (!Number.isFinite(value)) return '--';
      return `${value.toFixed(1)} GB`;
    };

    const bytesPerGb = 1073741824;

    const alignMemorySeries = (cpuSamples, memorySamples, sampleIntervalMs) => {
      if (!Array.isArray(cpuSamples) || cpuSamples.length === 0) return [];
      if (!Array.isArray(memorySamples) || memorySamples.length === 0) {
        return cpuSamples.map(() => null);
      }

      if (cpuSamples.length === memorySamples.length) {
        const tsDelta = Math.abs(cpuSamples[0].ts - memorySamples[0].ts);
        if (tsDelta <= (sampleIntervalMs || 15000)) {
          return memorySamples.map(sample =>
            Number.isFinite(sample.usedBytes) ? sample.usedBytes / bytesPerGb : null
          );
        }
      }

      const maxDrift = Math.max(sampleIntervalMs || 15000, 5000) * 1.5;
      return cpuSamples.map((cpuSample) => {
        let closest = null;
        let closestDelta = Number.POSITIVE_INFINITY;
        for (const memorySample of memorySamples) {
          const delta = Math.abs(memorySample.ts - cpuSample.ts);
          if (delta < closestDelta) {
            closest = memorySample;
            closestDelta = delta;
          }
        }
        if (!closest || closestDelta > maxDrift) {
          return null;
        }
        return Number.isFinite(closest.usedBytes) ? closest.usedBytes / bytesPerGb : null;
      });
    };

    const renderCpuChart = (samples, coreCount, memorySamples, memoryIntervalMs) => {
      if (!cpuChartCanvas || !cpuChartEmptyState) {
        return;
      }
      if (!Array.isArray(samples) || samples.length === 0) {
        cpuChartCanvas.classList.add('d-none');
        cpuChartEmptyState.classList.remove('d-none');
        return;
      }

      cpuChartCanvas.classList.remove('d-none');
      cpuChartEmptyState.classList.add('d-none');

      const labels = samples.map(sample => dateFormatter.format(new Date(sample.ts)));
      const totalSeries = samples.map(sample => sample.avg * coreCount);
      const memorySeries = alignMemorySeries(samples, memorySamples, memoryIntervalMs);
      const memoryTotals = Array.isArray(memorySamples)
        ? memorySamples.map(sample => (Number.isFinite(sample.totalBytes) ? sample.totalBytes / bytesPerGb : 0))
        : [];
      const memoryValues = memorySeries.filter(value => Number.isFinite(value));

      const chartData = {
        labels,
        datasets: [
          {
            label: 'Total Utilization',
            data: totalSeries,
            borderColor: 'rgba(32, 201, 151, 0.9)',
            backgroundColor: 'rgba(32, 201, 151, 0.08)',
            pointRadius: 0,
            tension: 0.2,
            order: 1,
            yAxisID: 'y'
          },
          {
            label: 'Memory Used (GB)',
            data: memorySeries,
            borderColor: 'rgba(13, 110, 253, 0.9)',
            backgroundColor: 'rgba(13, 110, 253, 0.08)',
            pointRadius: 0,
            tension: 0.2,
            order: 2,
            yAxisID: 'memory'
          }
        ]
      };

      const maxTotal = totalSeries.length ? Math.max(...totalSeries) : 100;
      const baseMax = Math.max(coreCount * 100, 100);
      const scaledMax = Math.max(baseMax, maxTotal);
      const yAxisMax = Math.ceil(scaledMax / 100) * 100;

      const chartOptions = {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: {
          mode: 'index',
          intersect: false
        },
        scales: {
          x: {
            ticks: {
              maxTicksLimit: 8
            }
          },
          y: {
            min: 0,
            max: yAxisMax,
            ticks: {
              callback: (value) => `${value}%`
            }
          },
          memory: {
            min: 0,
            max: Math.max(1, Math.ceil(Math.max(...memoryTotals, ...memoryValues))),
            position: 'right',
            grid: {
              drawOnChartArea: false
            },
            ticks: {
              callback: (value) => `${Number(value).toFixed(1)} GB`
            }
          }
        },
        plugins: {
          legend: {
            position: 'top'
          },
          tooltip: {
            callbacks: {
              label: (context) => {
                const formatted = context.dataset.yAxisID === 'memory'
                  ? formatGb(context.parsed.y)
                  : formatPercent(context.parsed.y);
                return `${context.dataset.label}: ${formatted}`;
              }
            }
          }
        }
      };

      if (!cpuChart) {
        const ctx = cpuChartCanvas.getContext('2d');
        if (!ctx) {
          return;
        }
        cpuChart = new Chart(ctx, {
          type: 'line',
          data: chartData,
          options: chartOptions
        });
      } else {
        cpuChart.data.labels = chartData.labels;
        cpuChart.data.datasets = chartData.datasets;
        if (cpuChart.options && cpuChart.options.scales && cpuChart.options.scales.y) {
          cpuChart.options.scales.y.max = yAxisMax;
        }
        cpuChart.update('none');
      }
    };

    const cpuMetrics = {{{json cpuMetrics}}};
    const coreCount = cpuMetrics && Number.isFinite(cpuMetrics.coreCount) && cpuMetrics.coreCount > 0
      ? cpuMetrics.coreCount
      : 1;
    const memoryMetrics = {{{json memoryMetrics}}};
    renderCpuChart(
      cpuMetrics ? cpuMetrics.samples : [],
      coreCount,
      memoryMetrics ? memoryMetrics.samples : [],
      memoryMetrics ? memoryMetrics.sampleIntervalMs : null
    );
  });
</script>
