<div class="container-fluid">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h2 class="mb-0">Start Timing</h2>
            <p class="text-muted mt-1 mb-0">{{strategy.name}}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/strategies/{{strategy.id}}" class="btn btn-primary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>
                Strategy
            </a>
            {{#if template}}
            <a href="/templates/{{template.id}}" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-link me-1"></i>
                Template
            </a>
            {{/if}}
        </div>
    </div>

    {{#unless hasBacktests}}
    <div class="alert alert-info" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        Start timing will appear after this strategy has at least one stored run with daily snapshots.
    </div>
    {{/unless}}

    {{#if hasBacktests}}
    <div class="row g-4">
        <div class="col-12 col-xl-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-database me-2"></i>
                        Data Source
                    </h5>
                </div>
                <div class="card-body">
                    <form method="GET" action="/strategies/{{strategy.id}}/start-timing" class="mb-3">
                        <label for="startTimingBacktestId" class="form-label fw-semibold">Stored Run</label>
                        <div class="input-group">
                            <select id="startTimingBacktestId" name="backtestId" class="form-select">
                                {{#each backtestOptions}}
                                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                {{/each}}
                            </select>
                            <button type="submit" class="btn btn-outline-primary" title="Load run">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </form>

                    {{#if selectedBacktest}}
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-muted">Period</td>
                                    <td class="text-end fw-bold">{{selectedBacktest.periodLabel}}</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Ticker Universe</td>
                                    <td class="text-end">
                                        <span class="badge {{selectedBacktest.scopeBadge}}">{{selectedBacktest.scopeLabel}}</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Start</td>
                                    <td class="text-end fw-bold">{{formatDate selectedBacktest.startDate}}</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">End</td>
                                    <td class="text-end fw-bold">{{formatDate selectedBacktest.endDate}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>

        {{#if startTiming.hasData}}
        <div class="col-12 col-xl-8">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-link me-2"></i>
                        Market Correlation
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Window</th>
                                    <th scope="col">Benchmark</th>
                                    <th scope="col" class="text-end">Samples</th>
                                    <th scope="col" class="text-end">Correlation</th>
                                    <th scope="col" class="text-end">R2</th>
                                    <th scope="col" class="text-end">Strategy Median</th>
                                    <th scope="col" class="text-end pe-3">Benchmark Median</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each startTiming.marketCorrelations}}
                                <tr>
                                    <td class="fw-semibold ps-3">{{windowLabel}}</td>
                                    <td>{{benchmark}}</td>
                                    <td class="text-end">{{sampleCount}}</td>
                                    <td class="text-end fw-semibold {{#if (gt correlation 0)}}text-success{{else if (lt correlation 0)}}text-danger{{/if}}">
                                        {{toFixed correlation 2}}
                                    </td>
                                    <td class="text-end">{{toFixed rSquared 2}}</td>
                                    <td class="text-end {{#if (gt strategyMedianReturnPercent 0)}}text-success{{else if (lt strategyMedianReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyMedianReturnPercent}}
                                    </td>
                                    <td class="text-end pe-3">{{formatPercentAsPercent benchmarkMedianReturnPercent}}</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calendar-check me-2"></i>
                        Forward Return By Start Date
                    </h5>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Forward return horizon">
                        {{#each startTiming.windows}}
                        <input type="radio" class="btn-check start-timing-window" name="startTimingWindow" id="startTimingWindow-{{key}}" value="{{key}}" autocomplete="off" {{#if (eq key '1m')}}checked{{/if}}>
                        <label class="btn btn-outline-primary" for="startTimingWindow-{{key}}">{{label}}</label>
                        {{/each}}
                    </div>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 460px; width: 100%;">
                        <canvas id="startTimingSensitivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-table me-2"></i>
                        Forward Return Summary
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Window</th>
                                    <th scope="col" class="text-end">Samples</th>
                                    <th scope="col" class="text-end">Strategy</th>
                                    <th scope="col" class="text-end">SPY</th>
                                    <th scope="col" class="text-end">QQQ</th>
                                    <th scope="col" class="text-end">Positive</th>
                                    <th scope="col" class="text-end pe-3">Beat SPY</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each startTiming.sensitivitySummary}}
                                <tr>
                                    <td class="fw-semibold ps-3">{{label}}</td>
                                    <td class="text-end">{{sampleCount}}</td>
                                    <td class="text-end fw-semibold {{#if (gt strategyMedianReturnPercent 0)}}text-success{{else if (lt strategyMedianReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyMedianReturnPercent}}
                                    </td>
                                    <td class="text-end">{{formatPercentAsPercent spyMedianReturnPercent}}</td>
                                    <td class="text-end">{{formatPercentAsPercent qqqMedianReturnPercent}}</td>
                                    <td class="text-end">
                                        {{#if (and (defined strategyPositiveRate) (ne strategyPositiveRate null))}}
                                        {{formatRateAsPercent strategyPositiveRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                    <td class="text-end pe-3">
                                        {{#if (and (defined outperformSpyRate) (ne outperformSpyRate null))}}
                                        {{formatRateAsPercent outperformSpyRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-wave-square me-2"></i>
                        Outcomes By Market State
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Window</th>
                                    <th scope="col">Benchmark</th>
                                    <th scope="col">State</th>
                                    <th scope="col" class="text-end">Samples</th>
                                    <th scope="col" class="text-end">Strategy Median</th>
                                    <th scope="col" class="text-end">Strategy Avg</th>
                                    <th scope="col" class="text-end">Benchmark Median</th>
                                    <th scope="col" class="text-end">Positive</th>
                                    <th scope="col" class="text-end pe-3">Beat Benchmark</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each startTiming.marketStateSummary}}
                                <tr>
                                    <td class="fw-semibold ps-3">{{windowLabel}}</td>
                                    <td>{{benchmark}}</td>
                                    <td><span class="badge {{stateBadge}}">{{stateLabel}}</span></td>
                                    <td class="text-end">{{sampleCount}}</td>
                                    <td class="text-end fw-semibold {{#if (gt strategyMedianReturnPercent 0)}}text-success{{else if (lt strategyMedianReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyMedianReturnPercent}}
                                    </td>
                                    <td class="text-end {{#if (gt strategyAverageReturnPercent 0)}}text-success{{else if (lt strategyAverageReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyAverageReturnPercent}}
                                    </td>
                                    <td class="text-end">{{formatPercentAsPercent benchmarkMedianReturnPercent}}</td>
                                    <td class="text-end">
                                        {{#if (and (defined strategyPositiveRate) (ne strategyPositiveRate null))}}
                                        {{formatRateAsPercent strategyPositiveRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                    <td class="text-end pe-3">
                                        {{#if (and (defined outperformBenchmarkRate) (ne outperformBenchmarkRate null))}}
                                        {{formatRateAsPercent outperformBenchmarkRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                    <div class="border-top px-3 py-2 text-muted small">
                        Sideways bands:
                        {{#each startTiming.windows}}
                        {{label}} +/-{{formatPercentAsPercent sidewaysThresholdPercent}}{{#unless @last}}, {{/unless}}
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-project-diagram me-2"></i>
                        Strategy Return Vs Market Return
                    </h5>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Benchmark">
                        <input type="radio" class="btn-check start-timing-benchmark" name="startTimingBenchmark" id="startTimingBenchmark-SPY" value="SPY" autocomplete="off" checked>
                        <label class="btn btn-outline-primary" for="startTimingBenchmark-SPY">SPY</label>
                        <input type="radio" class="btn-check start-timing-benchmark" name="startTimingBenchmark" id="startTimingBenchmark-QQQ" value="QQQ" autocomplete="off">
                        <label class="btn btn-outline-primary" for="startTimingBenchmark-QQQ">QQQ</label>
                    </div>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 420px; width: 100%;">
                        <canvas id="startTimingScatterChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        {{else}}
        <div class="col-12 col-xl-8">
            <div class="alert alert-info mb-0" role="alert">
                <i class="fas fa-info-circle me-2"></i>
                This stored run does not have enough daily snapshots for 1W, 1M, or 3M forward-return timing.
            </div>
        </div>
        {{/if}}
    </div>
    {{/if}}
</div>

<script>
    (() => {
        const startTiming = {{{ json startTiming }}};
        let sensitivityChart = null;
        let scatterChart = null;
        let activeScatterBenchmark = 'SPY';

        const benchmarkReturnKeys = {
            SPY: 'spy',
            QQQ: 'qqq'
        };

        const stateMeta = {
            down: { label: 'Down', color: '#dc3545' },
            sideways: { label: 'Sideways', color: '#6c757d' },
            up: { label: 'Up', color: '#198754' }
        };

        function isFiniteNumber(value) {
            return typeof value === 'number' && Number.isFinite(value);
        }

        function formatPercent(value) {
            if (!isFiniteNumber(value)) return 'N/A';
            const sign = value > 0 ? '+' : '';
            return `${sign}${value.toFixed(2)}%`;
        }

        function getWindowConfig(windowKey) {
            return startTiming?.windows?.find((window) => window.key === windowKey) || startTiming?.windows?.[0] || null;
        }

        function getActiveWindowKey() {
            const input = document.querySelector('.start-timing-window:checked');
            return input?.value || '1m';
        }

        function getActiveBenchmark() {
            const input = document.querySelector('.start-timing-benchmark:checked');
            return input?.value || 'SPY';
        }

        function classifyMarketState(returnPercent, thresholdPercent) {
            if (returnPercent < -thresholdPercent) return 'down';
            if (returnPercent > thresholdPercent) return 'up';
            return 'sideways';
        }

        function getSensitivityDatasets(windowKey) {
            return [
                {
                    label: 'Strategy',
                    data: startTiming.sensitivityPoints.map((point) => point.returns?.[windowKey]?.strategy ?? null),
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.08)',
                    borderWidth: 2,
                    tension: 0.2,
                    pointRadius: 0
                },
                {
                    label: 'SPY',
                    data: startTiming.sensitivityPoints.map((point) => point.returns?.[windowKey]?.spy ?? null),
                    borderColor: '#198754',
                    backgroundColor: 'rgba(25, 135, 84, 0.08)',
                    borderWidth: 2,
                    tension: 0.2,
                    pointRadius: 0
                },
                {
                    label: 'QQQ',
                    data: startTiming.sensitivityPoints.map((point) => point.returns?.[windowKey]?.qqq ?? null),
                    borderColor: '#fd7e14',
                    backgroundColor: 'rgba(253, 126, 20, 0.08)',
                    borderWidth: 2,
                    tension: 0.2,
                    pointRadius: 0
                }
            ];
        }

        function renderSensitivityChart(windowKey) {
            const element = document.getElementById('startTimingSensitivityChart');
            if (!element || !startTiming || !Array.isArray(startTiming.sensitivityPoints) || startTiming.sensitivityPoints.length === 0) {
                return;
            }

            const labels = startTiming.sensitivityPoints.map((point) => point.date);
            const datasets = getSensitivityDatasets(windowKey);

            if (sensitivityChart) {
                sensitivityChart.data.labels = labels;
                sensitivityChart.data.datasets = datasets;
                sensitivityChart.update();
                return;
            }

            sensitivityChart = new Chart(element.getContext('2d'), {
                type: 'line',
                data: { labels, datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    spanGaps: false,
                    scales: {
                        x: { title: { display: true, text: 'Start Date' } },
                        y: {
                            title: { display: true, text: 'Forward Return' },
                            ticks: {
                                callback: (value) => formatPercent(Number(value))
                            }
                        }
                    },
                    plugins: {
                        legend: { display: true, position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: (context) => `${context.dataset.label}: ${formatPercent(context.parsed.y)}`
                            }
                        }
                    }
                }
            });
        }

        function getScatterDatasets(windowKey, benchmark) {
            const windowConfig = getWindowConfig(windowKey);
            if (!windowConfig) return [];

            const benchmarkKey = benchmarkReturnKeys[benchmark] || 'spy';
            const grouped = {
                down: [],
                sideways: [],
                up: []
            };

            startTiming.sensitivityPoints.forEach((point) => {
                const returns = point.returns?.[windowKey];
                const strategyReturn = returns?.strategy;
                const benchmarkReturn = returns?.[benchmarkKey];
                if (!isFiniteNumber(strategyReturn) || !isFiniteNumber(benchmarkReturn)) {
                    return;
                }

                const state = classifyMarketState(benchmarkReturn, windowConfig.sidewaysThresholdPercent);
                grouped[state].push({
                    x: benchmarkReturn,
                    y: strategyReturn,
                    date: point.date
                });
            });

            return Object.entries(stateMeta).map(([state, meta]) => ({
                label: meta.label,
                data: grouped[state],
                borderColor: meta.color,
                backgroundColor: meta.color,
                pointRadius: 3,
                pointHoverRadius: 5
            }));
        }

        function renderScatterChart(windowKey, benchmark) {
            const element = document.getElementById('startTimingScatterChart');
            if (!element || !startTiming || !Array.isArray(startTiming.sensitivityPoints) || startTiming.sensitivityPoints.length === 0) {
                return;
            }

            activeScatterBenchmark = benchmark;
            const datasets = getScatterDatasets(windowKey, benchmark);

            if (scatterChart) {
                scatterChart.data.datasets = datasets;
                scatterChart.options.scales.x.title.text = `${benchmark} Forward Return`;
                scatterChart.update();
                return;
            }

            scatterChart = new Chart(element.getContext('2d'), {
                type: 'scatter',
                data: { datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'nearest', intersect: true },
                    scales: {
                        x: {
                            title: { display: true, text: `${benchmark} Forward Return` },
                            ticks: {
                                callback: (value) => formatPercent(Number(value))
                            }
                        },
                        y: {
                            title: { display: true, text: 'Strategy Forward Return' },
                            ticks: {
                                callback: (value) => formatPercent(Number(value))
                            }
                        }
                    },
                    plugins: {
                        legend: { display: true, position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: (context) => {
                                    const point = context.raw || {};
                                    return [
                                        point.date || 'N/A',
                                        `Strategy: ${formatPercent(point.y)}`,
                                        `${activeScatterBenchmark}: ${formatPercent(point.x)}`
                                    ];
                                }
                            }
                        }
                    }
                }
            });
        }

        function renderCharts() {
            const windowKey = getActiveWindowKey();
            const benchmark = getActiveBenchmark();
            renderSensitivityChart(windowKey);
            renderScatterChart(windowKey, benchmark);
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart === 'undefined') return;
            renderCharts();

            document.querySelectorAll('.start-timing-window, .start-timing-benchmark').forEach((input) => {
                input.addEventListener('change', function () {
                    renderCharts();
                });
            });
        });
    })();
</script>
