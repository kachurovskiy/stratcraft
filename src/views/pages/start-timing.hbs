<div class="container-fluid">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h2 class="mb-0">Start Timing</h2>
            <p class="text-muted mt-1 mb-0">{{strategy.name}}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/strategies/{{strategy.id}}" class="btn btn-primary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>
                Strategy
            </a>
            {{#if template}}
            <a href="/templates/{{template.id}}" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-link me-1"></i>
                Template
            </a>
            {{/if}}
        </div>
    </div>

    {{#unless hasStartTimingSamples}}
    <div class="alert alert-info" role="alert">
        <i class="fas fa-info-circle me-2"></i>
        Queue a refresh to compute independent 3M start-timing samples. The page derives 1W, 1M, and 3M returns from those samples.
    </div>
    {{/unless}}

    <div class="row g-4">
        <div class="col-12 col-xl-4">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-database me-2"></i>
                        Timing Samples
                    </h5>
                </div>
                <div class="card-body">
                    <form method="GET" action="/strategies/{{strategy.id}}/start-timing" class="mb-3">
                        <label for="startTimingScopeView" class="form-label fw-semibold">Ticker Universe</label>
                        <div class="input-group">
                            <select id="startTimingScopeView" name="scope" class="form-select">
                                {{#each startTimingScopeOptions}}
                                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                                {{/each}}
                            </select>
                            <button type="submit" class="btn btn-outline-primary" title="Load samples">
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-muted">Scope</td>
                                    <td class="text-end fw-bold">{{selectedScopeLabel}}</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold text-muted">Samples</td>
                                    <td class="text-end fw-bold">{{startTimingSampleStats.count}}</td>
                                </tr>
                                {{#if startTimingSampleStats.earliestStartDate}}
                                <tr>
                                    <td class="fw-bold text-muted">First Start</td>
                                    <td class="text-end fw-bold">{{formatDate startTimingSampleStats.earliestStartDate}}</td>
                                </tr>
                                {{/if}}
                                {{#if startTimingSampleStats.latestStartDate}}
                                <tr>
                                    <td class="fw-bold text-muted">Latest Start</td>
                                    <td class="text-end fw-bold">{{formatDate startTimingSampleStats.latestStartDate}}</td>
                                </tr>
                                {{/if}}
                                {{#if startTimingSampleStats.latestCreatedAt}}
                                <tr>
                                    <td class="fw-bold text-muted">Refreshed</td>
                                    <td class="text-end fw-bold">{{formatDateTime startTimingSampleStats.latestCreatedAt}}</td>
                                </tr>
                                {{/if}}
                            </tbody>
                        </table>
                    </div>

                    <form method="POST" action="/strategies/{{strategy.id}}/start-timing/queue" class="border-top mt-3 pt-3">
                        {{> csrf-field}}
                        <input type="hidden" name="scope" value="{{selectedScope}}">
                        <div class="row g-2">
                            <div class="col-12">
                                <label for="startTimingWeeks" class="form-label fw-semibold">Weeks</label>
                                <input id="startTimingWeeks" name="weeks" type="number" min="1" max="{{startTimingDefaults.maxWeeks}}" value="{{startTimingDefaults.weeks}}" class="form-control">
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary w-100" {{#if pendingStartTimingJob}}disabled{{/if}}>
                                    <i class="fas fa-play me-1"></i>
                                    {{#if pendingStartTimingJob}}Refresh queued{{else}}Queue refresh{{/if}}
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {{#if startTiming.hasData}}
        <div class="col-12 col-xl-8">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-link me-2"></i>
                        Market Correlation
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Window</th>
                                    <th scope="col">Benchmark</th>
                                    <th scope="col" class="text-end">Samples</th>
                                    <th scope="col" class="text-end">Correlation</th>
                                    <th scope="col" class="text-end">R2</th>
                                    <th scope="col" class="text-end">Strategy Median</th>
                                    <th scope="col" class="text-end pe-3">Benchmark Median</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each startTiming.marketCorrelations}}
                                <tr>
                                    <td class="fw-semibold ps-3">{{windowLabel}}</td>
                                    <td>{{benchmark}}</td>
                                    <td class="text-end">{{sampleCount}}</td>
                                    <td class="text-end fw-semibold {{#if (gt correlation 0)}}text-success{{else if (lt correlation 0)}}text-danger{{/if}}">
                                        {{toFixed correlation 2}}
                                    </td>
                                    <td class="text-end">{{toFixed rSquared 2}}</td>
                                    <td class="text-end {{#if (gt strategyMedianReturnPercent 0)}}text-success{{else if (lt strategyMedianReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyMedianReturnPercent}}
                                    </td>
                                    <td class="text-end pe-3">{{formatPercentAsPercent benchmarkMedianReturnPercent}}</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calendar-check me-2"></i>
                        Forward Return By Start Date
                    </h5>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Forward return horizon">
                        {{#each startTiming.windows}}
                        <input type="radio" class="btn-check start-timing-window" name="startTimingWindow" id="startTimingWindow-{{key}}" value="{{key}}" autocomplete="off" {{#if (eq key '1m')}}checked{{/if}}>
                        <label class="btn btn-outline-primary" for="startTimingWindow-{{key}}">{{label}}</label>
                        {{/each}}
                    </div>
                </div>
                <div class="card-body">
                    <div id="startTimingReturnLegend" class="d-flex flex-wrap gap-3 small mb-3"></div>
                    <div style="position: relative; height: 460px; width: 100%;">
                        <canvas id="startTimingSensitivityChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-table me-2"></i>
                        Forward Return Summary
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Window</th>
                                    <th scope="col" class="text-end">Samples</th>
                                    <th scope="col" class="text-end">Strategy</th>
                                    <th scope="col" class="text-end">SPY</th>
                                    <th scope="col" class="text-end">QQQ</th>
                                    <th scope="col" class="text-end">Positive</th>
                                    <th scope="col" class="text-end pe-3">Beat SPY</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each startTiming.sensitivitySummary}}
                                <tr>
                                    <td class="fw-semibold ps-3">{{label}}</td>
                                    <td class="text-end">{{sampleCount}}</td>
                                    <td class="text-end fw-semibold {{#if (gt strategyMedianReturnPercent 0)}}text-success{{else if (lt strategyMedianReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyMedianReturnPercent}}
                                    </td>
                                    <td class="text-end">{{formatPercentAsPercent spyMedianReturnPercent}}</td>
                                    <td class="text-end">{{formatPercentAsPercent qqqMedianReturnPercent}}</td>
                                    <td class="text-end">
                                        {{#if (and (defined strategyPositiveRate) (ne strategyPositiveRate null))}}
                                        {{formatRateAsPercent strategyPositiveRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                    <td class="text-end pe-3">
                                        {{#if (and (defined outperformSpyRate) (ne outperformSpyRate null))}}
                                        {{formatRateAsPercent outperformSpyRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-7">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-wave-square me-2"></i>
                        Outcomes By Market State
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3">Window</th>
                                    <th scope="col">Benchmark</th>
                                    <th scope="col">State</th>
                                    <th scope="col" class="text-end">Samples</th>
                                    <th scope="col" class="text-end">Strategy Median</th>
                                    <th scope="col" class="text-end">Strategy Avg</th>
                                    <th scope="col" class="text-end">Benchmark Median</th>
                                    <th scope="col" class="text-end">Positive</th>
                                    <th scope="col" class="text-end pe-3">Beat Benchmark</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each startTiming.marketStateSummary}}
                                <tr>
                                    <td class="fw-semibold ps-3">{{windowLabel}}</td>
                                    <td>{{benchmark}}</td>
                                    <td><span class="badge {{stateBadge}}">{{stateLabel}}</span></td>
                                    <td class="text-end">{{sampleCount}}</td>
                                    <td class="text-end fw-semibold {{#if (gt strategyMedianReturnPercent 0)}}text-success{{else if (lt strategyMedianReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyMedianReturnPercent}}
                                    </td>
                                    <td class="text-end {{#if (gt strategyAverageReturnPercent 0)}}text-success{{else if (lt strategyAverageReturnPercent 0)}}text-danger{{/if}}">
                                        {{formatPercentAsPercent strategyAverageReturnPercent}}
                                    </td>
                                    <td class="text-end">{{formatPercentAsPercent benchmarkMedianReturnPercent}}</td>
                                    <td class="text-end">
                                        {{#if (and (defined strategyPositiveRate) (ne strategyPositiveRate null))}}
                                        {{formatRateAsPercent strategyPositiveRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                    <td class="text-end pe-3">
                                        {{#if (and (defined outperformBenchmarkRate) (ne outperformBenchmarkRate null))}}
                                        {{formatRateAsPercent outperformBenchmarkRate}}
                                        {{else}}N/A{{/if}}
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                    <div class="border-top px-3 py-2 text-muted small">
                        Sideways bands:
                        {{#each startTiming.windows}}
                        {{label}} +/-{{formatPercentAsPercent sidewaysThresholdPercent}}{{#unless @last}}, {{/unless}}
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex flex-column flex-md-row justify-content-md-between align-items-md-center gap-2">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-project-diagram me-2"></i>
                        Strategy Return Vs Market Return
                    </h5>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Benchmark">
                        <input type="radio" class="btn-check start-timing-benchmark" name="startTimingBenchmark" id="startTimingBenchmark-SPY" value="SPY" autocomplete="off" checked>
                        <label class="btn btn-outline-primary" for="startTimingBenchmark-SPY">SPY</label>
                        <input type="radio" class="btn-check start-timing-benchmark" name="startTimingBenchmark" id="startTimingBenchmark-QQQ" value="QQQ" autocomplete="off">
                        <label class="btn btn-outline-primary" for="startTimingBenchmark-QQQ">QQQ</label>
                    </div>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 420px; width: 100%;">
                        <canvas id="startTimingScatterChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        {{else}}
        <div class="col-12 col-xl-8">
            <div class="alert alert-info mb-0" role="alert">
                <i class="fas fa-info-circle me-2"></i>
                Start timing samples do not yet have enough daily snapshots for 1W, 1M, or 3M forward-return timing.
            </div>
        </div>
        {{/if}}
    </div>
</div>

<script>
    (() => {
        const startTiming = {{{ json startTiming }}};
        const benchmarkChartData = startTiming?.benchmarkChartData || { spy: [], qqq: [] };
        let sensitivityChart = null;
        let scatterChart = null;
        let activeScatterBenchmark = 'SPY';

        const benchmarkReturnKeys = {
            SPY: 'spy',
            QQQ: 'qqq'
        };

        const stateMeta = {
            down: { label: 'Down', color: '#dc3545' },
            sideways: { label: 'Sideways', color: '#6c757d' },
            up: { label: 'Up', color: '#198754' }
        };

        const returnBucketMeta = [
            { key: 'veryNegative', label: 'Very negative', color: '#842029' },
            { key: 'negative', label: 'Somewhat negative', color: '#dc3545' },
            { key: 'flat', label: 'Flat', color: '#6c757d' },
            { key: 'positive', label: 'Somewhat positive', color: '#198754' },
            { key: 'veryPositive', label: 'Very positive', color: '#0f5132' }
        ];

        function isFiniteNumber(value) {
            return typeof value === 'number' && Number.isFinite(value);
        }

        function formatPercent(value) {
            if (!isFiniteNumber(value)) return 'N/A';
            const sign = value > 0 ? '+' : '';
            return `${sign}${value.toFixed(2)}%`;
        }

        function formatPrice(value) {
            if (!isFiniteNumber(value)) return 'N/A';
            return `$${value.toFixed(value >= 100 ? 0 : 2)}`;
        }

        function getWindowConfig(windowKey) {
            return startTiming?.windows?.find((window) => window.key === windowKey) || startTiming?.windows?.[0] || null;
        }

        function getActiveWindowKey() {
            const input = document.querySelector('.start-timing-window:checked');
            return input?.value || '1m';
        }

        function getActiveBenchmark() {
            const input = document.querySelector('.start-timing-benchmark:checked');
            return input?.value || 'SPY';
        }

        function classifyMarketState(returnPercent, thresholdPercent) {
            if (returnPercent < -thresholdPercent) return 'down';
            if (returnPercent > thresholdPercent) return 'up';
            return 'sideways';
        }

        function normalizeDateKey(value) {
            if (typeof value !== 'string') return null;
            const trimmed = value.trim();
            if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) return trimmed;
            const parsed = new Date(trimmed);
            return Number.isNaN(parsed.getTime()) ? null : parsed.toISOString().slice(0, 10);
        }

        function normalizeBenchmarkSeries(series) {
            if (!Array.isArray(series)) return [];

            const valueByDate = new Map();
            series.forEach((point) => {
                const date = normalizeDateKey(point?.date);
                const value = Number(point?.value);
                if (date && Number.isFinite(value) && value > 0) {
                    valueByDate.set(date, value);
                }
            });

            return Array.from(valueByDate.entries())
                .map(([date, value]) => ({ date, value }))
                .sort((a, b) => a.date.localeCompare(b.date));
        }

        function getBenchmarkChartLabels() {
            return Array.from(new Set([
                ...normalizeBenchmarkSeries(benchmarkChartData.spy).map((point) => point.date),
                ...normalizeBenchmarkSeries(benchmarkChartData.qqq).map((point) => point.date)
            ])).sort((a, b) => a.localeCompare(b));
        }

        function findPointAtOrAfter(series, date) {
            let low = 0;
            let high = series.length - 1;
            let result = null;

            while (low <= high) {
                const middle = Math.floor((low + high) / 2);
                if (series[middle].date >= date) {
                    result = series[middle];
                    high = middle - 1;
                } else {
                    low = middle + 1;
                }
            }

            return result;
        }

        function classifyStrategyReturn(returnPercent, thresholdPercent) {
            if (returnPercent <= thresholdPercent * -2) return returnBucketMeta[0];
            if (returnPercent < thresholdPercent * -1) return returnBucketMeta[1];
            if (returnPercent >= thresholdPercent * 2) return returnBucketMeta[4];
            if (returnPercent > thresholdPercent) return returnBucketMeta[3];
            return returnBucketMeta[2];
        }

        function getReturnBucketDescription(bucket, thresholdPercent) {
            if (bucket.key === 'veryNegative') return `<= ${formatPercent(-2 * thresholdPercent)}`;
            if (bucket.key === 'negative') return `${formatPercent(-2 * thresholdPercent)} to ${formatPercent(-thresholdPercent)}`;
            if (bucket.key === 'positive') return `${formatPercent(thresholdPercent)} to ${formatPercent(2 * thresholdPercent)}`;
            if (bucket.key === 'veryPositive') return `>= ${formatPercent(2 * thresholdPercent)}`;
            return `${formatPercent(-thresholdPercent)} to ${formatPercent(thresholdPercent)}`;
        }

        function renderReturnLegend(windowKey) {
            const legend = document.getElementById('startTimingReturnLegend');
            const windowConfig = getWindowConfig(windowKey);
            if (!legend || !windowConfig) return;

            legend.replaceChildren();
            returnBucketMeta.forEach((bucket) => {
                const item = document.createElement('span');
                item.className = 'd-inline-flex align-items-center gap-1 text-muted';

                const swatch = document.createElement('span');
                swatch.style.display = 'inline-block';
                swatch.style.width = '0.75rem';
                swatch.style.height = '0.75rem';
                swatch.style.borderRadius = '50%';
                swatch.style.backgroundColor = bucket.color;

                const label = document.createElement('span');
                label.textContent = `${bucket.label} (${getReturnBucketDescription(bucket, windowConfig.sidewaysThresholdPercent)})`;

                item.appendChild(swatch);
                item.appendChild(label);
                legend.appendChild(item);
            });
        }

        function getTimingMarkerData(windowKey, benchmarkKey, benchmarkLabel) {
            const windowConfig = getWindowConfig(windowKey);
            const priceSeries = normalizeBenchmarkSeries(benchmarkChartData[benchmarkKey]);
            if (!windowConfig || priceSeries.length === 0) return [];

            return startTiming.sensitivityPoints
                .map((point) => {
                    const startDate = normalizeDateKey(point.date);
                    const strategyReturn = point.returns?.[windowKey]?.strategy;
                    if (!startDate || !isFiniteNumber(strategyReturn)) return null;

                    const pricePoint = findPointAtOrAfter(priceSeries, startDate);
                    if (!pricePoint) return null;

                    const bucket = classifyStrategyReturn(strategyReturn, windowConfig.sidewaysThresholdPercent);
                    return {
                        x: pricePoint.date,
                        y: pricePoint.value,
                        benchmark: benchmarkLabel,
                        startDate,
                        priceDate: pricePoint.date,
                        strategyReturn,
                        bucketKey: bucket.key,
                        bucketLabel: bucket.label,
                        bucketColor: bucket.color,
                        radius: bucket.key === 'veryNegative' || bucket.key === 'veryPositive' ? 5 : 4
                    };
                })
                .filter(Boolean);
        }

        function getBenchmarkTimingDatasets(windowKey) {
            const spySeries = normalizeBenchmarkSeries(benchmarkChartData.spy);
            const qqqSeries = normalizeBenchmarkSeries(benchmarkChartData.qqq);
            const spyMarkers = getTimingMarkerData(windowKey, 'spy', 'SPY');
            const qqqMarkers = getTimingMarkerData(windowKey, 'qqq', 'QQQ');
            const datasets = [];

            if (spySeries.length > 0) {
                datasets.push({
                    label: 'SPY Close',
                    data: spySeries.map((point) => ({ x: point.date, y: point.value })),
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.08)',
                    borderWidth: 2,
                    fill: false,
                    tension: 0.2,
                    pointRadius: 0,
                    pointHoverRadius: 3
                });
            }

            if (qqqSeries.length > 0) {
                datasets.push({
                    label: 'QQQ Close',
                    data: qqqSeries.map((point) => ({ x: point.date, y: point.value })),
                    borderColor: '#fd7e14',
                    backgroundColor: 'rgba(253, 126, 20, 0.08)',
                    borderWidth: 2,
                    fill: false,
                    tension: 0.2,
                    pointRadius: 0,
                    pointHoverRadius: 3
                });
            }

            if (spyMarkers.length > 0) {
                datasets.push({
                    label: 'SPY start weeks',
                    data: spyMarkers,
                    showLine: false,
                    pointStyle: 'circle',
                    pointRadius: spyMarkers.map((point) => point.radius),
                    pointHoverRadius: 7,
                    pointBackgroundColor: spyMarkers.map((point) => point.bucketColor),
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 1.5
                });
            }

            if (qqqMarkers.length > 0) {
                datasets.push({
                    label: 'QQQ start weeks',
                    data: qqqMarkers,
                    showLine: false,
                    pointStyle: 'rectRot',
                    pointRadius: qqqMarkers.map((point) => point.radius),
                    pointHoverRadius: 7,
                    pointBackgroundColor: qqqMarkers.map((point) => point.bucketColor),
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 1.5
                });
            }

            return datasets;
        }

        function renderSensitivityChart(windowKey) {
            const element = document.getElementById('startTimingSensitivityChart');
            if (!element || !startTiming || !Array.isArray(startTiming.sensitivityPoints) || startTiming.sensitivityPoints.length === 0) {
                return;
            }

            renderReturnLegend(windowKey);
            const labels = getBenchmarkChartLabels();
            const datasets = getBenchmarkTimingDatasets(windowKey);

            if (sensitivityChart) {
                sensitivityChart.data.labels = labels;
                sensitivityChart.data.datasets = datasets;
                sensitivityChart.update();
                return;
            }

            sensitivityChart = new Chart(element.getContext('2d'), {
                type: 'line',
                data: { labels, datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'nearest', intersect: false },
                    spanGaps: true,
                    scales: {
                        x: { type: 'category', title: { display: true, text: 'Start Date' } },
                        y: {
                            title: { display: true, text: 'Close Price' },
                            ticks: {
                                callback: (value) => formatPrice(Number(value))
                            }
                        }
                    },
                    plugins: {
                        legend: { display: true, position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: (context) => {
                                    const point = context.raw || {};
                                    if (isFiniteNumber(point.strategyReturn)) {
                                        const lines = [
                                            `${point.benchmark}: ${formatPrice(point.y)}`,
                                            `Start: ${point.startDate}`,
                                            `Strategy: ${formatPercent(point.strategyReturn)}`,
                                            `Bucket: ${point.bucketLabel}`
                                        ];
                                        if (point.priceDate && point.priceDate !== point.startDate) {
                                            lines.splice(2, 0, `Price date: ${point.priceDate}`);
                                        }
                                        return lines;
                                    }
                                    return `${context.dataset.label}: ${formatPrice(context.parsed.y)}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        function getScatterDatasets(windowKey, benchmark) {
            const windowConfig = getWindowConfig(windowKey);
            if (!windowConfig) return [];

            const benchmarkKey = benchmarkReturnKeys[benchmark] || 'spy';
            const grouped = {
                down: [],
                sideways: [],
                up: []
            };

            startTiming.sensitivityPoints.forEach((point) => {
                const returns = point.returns?.[windowKey];
                const strategyReturn = returns?.strategy;
                const benchmarkReturn = returns?.[benchmarkKey];
                if (!isFiniteNumber(strategyReturn) || !isFiniteNumber(benchmarkReturn)) {
                    return;
                }

                const state = classifyMarketState(benchmarkReturn, windowConfig.sidewaysThresholdPercent);
                grouped[state].push({
                    x: benchmarkReturn,
                    y: strategyReturn,
                    date: point.date
                });
            });

            return Object.entries(stateMeta).map(([state, meta]) => ({
                label: meta.label,
                data: grouped[state],
                borderColor: meta.color,
                backgroundColor: meta.color,
                pointRadius: 3,
                pointHoverRadius: 5
            }));
        }

        function renderScatterChart(windowKey, benchmark) {
            const element = document.getElementById('startTimingScatterChart');
            if (!element || !startTiming || !Array.isArray(startTiming.sensitivityPoints) || startTiming.sensitivityPoints.length === 0) {
                return;
            }

            activeScatterBenchmark = benchmark;
            const datasets = getScatterDatasets(windowKey, benchmark);

            if (scatterChart) {
                scatterChart.data.datasets = datasets;
                scatterChart.options.scales.x.title.text = `${benchmark} Forward Return`;
                scatterChart.update();
                return;
            }

            scatterChart = new Chart(element.getContext('2d'), {
                type: 'scatter',
                data: { datasets },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'nearest', intersect: true },
                    scales: {
                        x: {
                            title: { display: true, text: `${benchmark} Forward Return` },
                            ticks: {
                                callback: (value) => formatPercent(Number(value))
                            }
                        },
                        y: {
                            title: { display: true, text: 'Strategy Forward Return' },
                            ticks: {
                                callback: (value) => formatPercent(Number(value))
                            }
                        }
                    },
                    plugins: {
                        legend: { display: true, position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: (context) => {
                                    const point = context.raw || {};
                                    return [
                                        point.date || 'N/A',
                                        `Strategy: ${formatPercent(point.y)}`,
                                        `${activeScatterBenchmark}: ${formatPercent(point.x)}`
                                    ];
                                }
                            }
                        }
                    }
                }
            });
        }

        function renderCharts() {
            const windowKey = getActiveWindowKey();
            const benchmark = getActiveBenchmark();
            renderSensitivityChart(windowKey);
            renderScatterChart(windowKey, benchmark);
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Chart === 'undefined') return;
            renderCharts();

            document.querySelectorAll('.start-timing-window, .start-timing-benchmark').forEach((input) => {
                input.addEventListener('change', function () {
                    renderCharts();
                });
            });
        });
    })();
</script>
